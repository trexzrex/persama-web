# Database Supabase (Postgres). Pakai connection string pooler untuk Vercel.
DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Rahasia Payload (acak, minimal 32 karakter).
PAYLOAD_SECRET=ganti-dengan-rahasia-acak

# Cloudflare R2 (S3 API). Kosongkan saat pengembangan lokal tanpa R2.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.persama.my.id

# Alamat situs publik, dipakai untuk metadata dan cron.
NEXT_PUBLIC_SITE_URL=https://persama.my.id
